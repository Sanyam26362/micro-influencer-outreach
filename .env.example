# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Rename this file to .env and provide your actual API keys and credentials.
# Do NOT commit your actual .env file to version control.

# Google YouTube Data API v3 Key (from Google Cloud Console)
# Required by: discovery.py
YOUTUBE_API_KEY=your_youtube_api_key_here

# Groq Cloud API Key (from console.groq.com)
# Required by: process_data.py, generate_and_send.py
GROQ_API_KEY=your_groq_api_key_here

# SMTP Email Credentials (for sending outreach emails)
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
# Required by: generate_and_send.py
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
